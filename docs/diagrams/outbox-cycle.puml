@startuml
title ecst-go: один заход outbox-воркера
hide footbox
autonumber

participant "outboxWorker.run" as Run
participant "processBatch" as Batch
database "OutboxStore" as Store
participant "producer" as P
queue "Kafka" as K

Run -> Batch : ctx с BatchTimeout

Batch -> Store : Fetch(BatchSize)
note right of Batch : backoff.Retry, StoreMaxAttempts
alt ошибка после всех попыток
  Store --> Batch : err
  Batch --> Run : заход провален
  Run -> Run : log ERROR
else пусто
  Store --> Batch : []
  Batch --> Run : sent = 0
else строки есть
  Store --> Batch : msgs

  loop по каждому msg
    Batch -> Batch : record():\nkey=EntityID, value=Encode(),\nheaders=envelope_type, trace_id
    alt конверт битый / Topic пуст
      Batch -> Store : MarkFailed(id, cause)
      note right : ctx отвязан от отмены;\nиначе строка вернется\nиз следующего Fetch
    end
  end

  Batch -> P : ProduceSyncResults(records...)
  P -> K : батч
  K --> P : результат по каждой записи
  P --> Batch : []Result

  loop по каждому Result
    alt Err == nil
      Batch -> Batch : id -> в список MarkSent
    else producer.Permanent(Err)
      Batch -> Store : MarkFailed(id, Err)
    else transient
      Batch -> Batch : failed++, log ERROR\n(строка остается неотмеченной)
    end
  end

  alt есть доехавшие
    Batch -> Store : MarkSent(ids)
    note right of Batch
      ctx отвязан от отмены + BatchTimeout:
      неотмеченная строка = дубль у получателя
    end note
  end

  Batch --> Run : sent = len(ids)
end

alt sent == BatchSize
  Run -> Run : следующий заход без паузы\n(в таблице скорее всего есть еще)
else
  Run -> Run : ждать PollInterval или отмену ctx
end
@enduml
